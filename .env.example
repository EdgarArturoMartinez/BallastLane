# Example environment variables — copy to .env and set real values (DO NOT COMMIT .env)
# Copy with: cp .env.example .env

# SQL Server SA password used by docker-compose and local integration helpers
SA_PASSWORD=your-sa-password

# JWT secret used by API (must be at least 32 characters)
JWT_SECRET=replace-with-a-32-char-min-secret

# Optional: full connection string for integration tests (overrides SA_PASSWORD usage)
# Example: Server=localhost,1433;User Id=sa;Password=${SA_PASSWORD};TrustServerCertificate=True;
SQLSERVER_INTEGRATION_CONNSTR=Server=localhost,1433;User Id=sa;Password=${SA_PASSWORD};TrustServerCertificate=True;
