<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.2.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Ballastlane.Infrastructure\Ballastlane.Infrastructure.csproj" />
    <ProjectReference Include="..\Ballastlane.Application\Ballastlane.Application.csproj" />
    <ProjectReference Include="..\Ballastlane.Domain\Ballastlane.Domain.csproj" />
  </ItemGroup>

  <!-- Copy SQL migration scripts to output so DbMigrator can find them at runtime -->
  <ItemGroup>
    <Content Include="..\..\sql\migrations\*.sql">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>sql\migrations\%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
  </ItemGroup>
</Project>
