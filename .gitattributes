# Enforce text normalization and recommend UTF-8 working-tree encoding (if supported)
* text=auto
* working-tree-encoding=UTF-8

# Normalize common text file types to LF and treat as text
*.cs text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary files — skip text normalization
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.woff2 binary
